@unpublished{feynman06,
    Author = {Islam, K. R., Debnath, P. C., et al.},
    Title = {Tracing the Journey of Microplastics in the Northern Bay of Bengal Marine Ecosystems, Bangladesh: A Comprehensive Study on Source Appointments, Distribution, and Potential Risks},
    Note = {arXiv:2006.08594},
    arxiv = {2006.08594},
    file = {feynman06.pdf},
    abstract = {Microplastics (MPs) pose a substantial environmental threat, jeopardizing marine ecosystems and biodiversity worldwide. This study provides a comprehensive assessment of MP pollution in the Northern Bay of Bengal Marine Ecosystems, Bangladesh (Kuakata Sea Beach), offering a multi-matrix evaluation of MPs across surface water, sediment, and marine biota (fish, crustaceans, and mollusca)—a novel approach for this region. MP characterization was conducted using stereomicroscopy and Attenuated Total Reflectance Fourier Transform Infrared Spectroscopy (ATR-FTIR) to ensure precise polymer identification. The study reveals significant MP contamination across all matrices, with concentrations reaching 145.5 ± 33.1 items/L in surface water, 362.2 ± 57.2 items/kg dry weight in sediment, and varying levels in biota (23.8 ± 6.3 items/individual fish, 27.3 ± 6.9 items/individual crustacean, and 34.1 ± 3.6 items/individual mollusca). Fibrous MPs dominated the samples, typically exceeding 0.1 mm in size, except in crustaceans. The most abundant polymer types were polyethylene (PE), polypropylene (PP), polyethylene terephthalate (PET), polystyrene (PS), polyvinyl chloride (PVC), Nylon-6, and Polyurethane (PUR). Unlike previous studies, this research integrates pollution evaluation indices (CF, NPI, PLI) to quantify MP risks across all matrices, revealing a spectrum of pollution levels ranging from low to very high. High polymer-associated risks were recorded for surface water and beach sediments, highlighting the potential ecological consequences of MP accumulation. Among biota, J. belangerii (fish), O. macrocera (crustacean), and O. vulgaris (mollusc) exhibited the highest levels of MP contamination, reinforcing concerns regarding marine food chain disruption. Furthermore, this study presents a critical human exposure assessment, estimating that children ingest nearly three times more MPs than adults through seafood consumption-a finding that underscores the urgent need for public health interventions and policy responses. The estimated exposure levels for children are 15.48 ± 5.17, 21.81 ± 5.24, and 22.01 ± 6.49 MPs per day, while adults are exposed to 4.22 ±1.41, 5.95 ± 1.43, and 6.0 ± 1.77 MPs per day for fish, crustaceans, and mollusca, respectively. This study uniquely integrates environmental and human risk assessments, bridging ecosystem health with public health concerns. This research contributes novel insights into regional and global microplastic pollution assessments, reinforcing the necessity of sustainable policy measures to mitigate marine plastic contamination.},
}

